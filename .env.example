# n8n Webhook URL
# Obtenha esta URL ativando o workflow no n8n
# A URL será algo como: https://api.artur.digital/webhook/face-swap
NEXT_PUBLIC_WEBHOOK_URL=https://api.artur.digital/webhook/face-swap

# Base64 das imagens dos pôsteres de referência
# Você precisa converter as imagens dos pôsteres para base64
# Use: cat poster1.jpg | base64
NEXT_PUBLIC_POSTER1_BASE64=
NEXT_PUBLIC_POSTER2_BASE64=
